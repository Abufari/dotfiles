" ~/.vimrc -- fallback for hosts that have Vim but no Neovim.
"
" Goal: the same hands-on feel as the AstroNvim setup (leader, jk, H/L, <Leader>
" mnemonics, 2-space indent, relative numbers), not the same feature set: no LSP,
" no completion engine, no git UI. Needs Vim >= 8.0 with +eval (not vim.tiny).
" No plugins and no network access required. Anything newer than 8.0 is guarded
" with silent!/has(), so older builds load this file without errors, they just
" do less. Optional plugins can go into ~/.vim/pack/*/start/, nothing here
" depends on them.

set nocompatible
set encoding=utf-8

" --- Base -------------------------------------------------------------------
" Having a vimrc disables the bundled defaults.vim, so source it explicitly
" (syntax, filetype plugin/indent, incsearch, wildmenu, mouse, restore cursor
" position, matchit). Neovim has the same set built in.
unlet! skip_defaults_vim
silent! source $VIMRUNTIME/defaults.vim
syntax on
filetype plugin indent on

let mapleader = ' '
let maplocalleader = ','
nnoremap <Space> <Nop>

" --- Options (values read from the running Neovim) --------------------------
set hidden                      " H/L fail on unsaved buffers without this
set autoindent smarttab
set expandtab tabstop=2 shiftwidth=0 softtabstop=0 shiftround
set number relativenumber cursorline nowrap linebreak breakindent
set ignorecase smartcase infercase incsearch hlsearch
set splitright splitbelow confirm autoread virtualedit=block
set scrolloff=0 history=10000 mouse=a laststatus=2
set timeoutlen=500 ttimeout ttimeoutlen=50
set completeopt=menu,menuone,noselect shortmess+=Ic
silent! set belloff=all
silent! set wildoptions=pum
silent! set ttymouse=sgr
let g:markdown_recommended_style = 0

" swap and undo files in one private place instead of next to the edited file
let s:state = expand('~/.vim/state')
silent! call mkdir(s:state . '/swap', 'p', 0700)
silent! call mkdir(s:state . '/undo', 'p', 0700)
if isdirectory(s:state . '/swap')
  let &directory = escape(s:state, ' ,') . '/swap//,.'
endif
if has('persistent_undo') && isdirectory(s:state . '/undo')
  let &undodir = escape(s:state, ' ,') . '/undo'
  set undofile
endif

" --- Colors: Catppuccin Mocha like in Neovim (bundled with Vim >= 9.2) --------
set background=dark
if has('termguicolors') && ($COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit')
  if &term =~# '^\(tmux\|screen\)'
    let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
    let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
  endif
  set termguicolors
endif
for s:scheme in ['catppuccin', 'habamax', 'desert']
  try | execute 'colorscheme' s:scheme | break | catch /^Vim\%((\a\+)\)\=:E185:/ | endtry
endfor

" --- Clipboard --------------------------------------------------------------
if has('unnamedplus')
  set clipboard^=unnamedplus
else
  silent! set clipboard^=unnamed  " macOS, or provider-only builds (OSC 52)
endif
if !empty($SSH_TTY)
  " no local clipboard on a remote host: Vim 9.2 can push yanks to the
  " terminal via OSC 52 (package osc52; tmux may need `set -g set-clipboard on`)
  let g:osc52_disable_paste = 1
  silent! packadd osc52
  silent! set clipmethod+=osc52
endif
silent! packadd hlyank          " yank highlight, recent Vim only

" --- Editing ----------------------------------------------------------------
inoremap jk <Esc>
inoremap jj <Esc>
nnoremap Y y$
nnoremap <expr> j v:count == 0 ? 'gj' : 'j'
nnoremap <expr> k v:count == 0 ? 'gk' : 'k'
xnoremap <expr> j v:count == 0 ? 'gj' : 'j'
xnoremap <expr> k v:count == 0 ? 'gk' : 'k'
xnoremap <Tab>   >gv
xnoremap <S-Tab> <gv
nnoremap <silent> <Leader>h :nohlsearch<CR>
nnoremap <silent> <Leader>uw :set wrap!<CR>
nnoremap <silent> <Leader>us :set spell!<CR>

" --- Files, buffers, windows ------------------------------------------------
nnoremap <silent> <Leader>w :write<CR>
nnoremap <silent> <Leader>q :confirm quit<CR>
nnoremap <silent> <Leader>Q :confirm qall<CR>
nnoremap <silent> <Leader>n :enew<CR>
nnoremap <silent> <Bar> :vsplit<CR>
nnoremap <silent> \     :split<CR>

nnoremap <silent> H  :<C-u>execute v:count1 . 'bprevious'<CR>
nnoremap <silent> L  :<C-u>execute v:count1 . 'bnext'<CR>
nnoremap <silent> [b :<C-u>execute v:count1 . 'bprevious'<CR>
nnoremap <silent> ]b :<C-u>execute v:count1 . 'bnext'<CR>
nnoremap <silent> [t :tabprevious<CR>
nnoremap <silent> ]t :tabnext<CR>
nnoremap <silent> [q :<C-u>execute v:count1 . 'cprevious'<CR>
nnoremap <silent> ]q :<C-u>execute v:count1 . 'cnext'<CR>

nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
nnoremap <silent> <C-Up>    :resize -2<CR>
nnoremap <silent> <C-Down>  :resize +2<CR>
nnoremap <silent> <C-Left>  :vertical resize -2<CR>
nnoremap <silent> <C-Right> :vertical resize +2<CR>

" close the buffer but keep the window (like AstroNvim's <Leader>c)
function! s:CloseBuffer() abort
  if len(filter(range(1, bufnr('$')), 'buflisted(v:val)')) > 1
    bprevious
    confirm bdelete #
  else
    confirm bdelete
  endif
endfunction
nnoremap <silent> <Leader>c :call <SID>CloseBuffer()<CR>

" --- Find (native stand-ins for the snacks pickers) -------------------------
" Vim has no fuzzy file completion; :find takes globs, so type `*part<Tab>`.
set path=.,,**
set wildignore+=*/.git/*,*/node_modules/*,*/__pycache__/*,*/.venv/*,*.pyc
nnoremap <Leader>ff :find *
nnoremap <Leader>fb :ls<CR>:buffer<Space>
nnoremap <Leader>fo :browse oldfiles<CR>
nnoremap <Leader>fh :help<Space>

if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case\ --hidden\ --glob\ '!.git'
  set grepformat=%f:%l:%c:%m
else
  set grepprg=grep\ -rnIH\ --exclude-dir=.git\ $*\ .
endif
command! -nargs=+ -complete=file Grep silent grep! <args> | redraw! | cwindow
nnoremap <Leader>fw :Grep<Space>
nnoremap <Leader>fc :Grep <C-r><C-w><CR>

" netrw as the explorer sidebar
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_winsize = 25
let g:netrw_browse_split = 4
nnoremap <silent> <Leader>e :Lexplore<CR>

" --- Autocommands -----------------------------------------------------------
augroup vimrc
  autocmd!
  autocmd FocusGained,BufEnter * silent! checktime
  autocmd FileType help,qf nnoremap <buffer> <silent> q :close<CR>
augroup END

" --- Comments: gc / gcc / {Visual}gc, <Leader>/ -----------------------------
" Recent Vim (tested: 9.1.1752, 9.2) bundles this as a package with the same
" keys as Neovim. Older builds get a minimal toggle driven by 'commentstring'.
silent! packadd comment
if empty(maparg('gc', 'n'))
  function! s:ToggleComment(first, last) abort
    let l:parts = split(&commentstring, '%s', 1)
    let l:lhs = substitute(l:parts[0], '\s\+$', '', '')
    let l:rhs = len(l:parts) > 1 ? substitute(l:parts[1], '^\s\+', '', '') : ''
    if empty(l:lhs) | return | endif
    let l:tail = empty(l:rhs) ? '\(\.\*\)\$' : '\(\.\{-}\)\s\?' . escape(l:rhs, '\') . '\$'
    let l:pat = '\V\^\(\s\*\)' . escape(l:lhs, '\') . '\s\?' . l:tail
    let l:code = filter(getline(a:first, a:last), 'v:val =~# "\\S"')
    if empty(l:code) | return | endif
    let l:uncomment = empty(filter(copy(l:code), 'v:val !~# l:pat'))
    let l:indent = min(map(copy(l:code), 'len(matchstr(v:val, "^\\s*"))'))
    for l:n in range(a:first, a:last)
      let l:line = getline(l:n)
      if l:line !~# '\S' | continue | endif
      if l:uncomment
        call setline(l:n, substitute(l:line, l:pat, '\1\2', ''))
      else
        call setline(l:n, strpart(l:line, 0, l:indent) . l:lhs . ' '
              \ . strpart(l:line, l:indent) . (empty(l:rhs) ? '' : ' ' . l:rhs))
      endif
    endfor
  endfunction
  function! s:CommentOp(type) abort
    call s:ToggleComment(line("'["), line("']"))
  endfunction
  nnoremap <silent> gc  :set operatorfunc=<SID>CommentOp<CR>g@
  nnoremap <silent> gcc :<C-u>call <SID>ToggleComment(line('.'), line('.') + v:count1 - 1)<CR>
  xnoremap <silent> gc  :<C-u>call <SID>ToggleComment(line("'<"), line("'>"))<CR>
endif
nmap <Leader>/ gcc
xmap <Leader>/ gc
